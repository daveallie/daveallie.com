{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "sourceMap": true,
    "target": "esnext",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "paths": {
      "~*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "api/**/*"]
}
